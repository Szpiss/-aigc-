.item {
  width: 100%;
  min-height: 148rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  margin: 18rpx auto 0 auto;
  display: flex;
  justify-content: space-between;
  overflow: hidden;
  border: 1rpx solid rgba(124, 170, 232, 0.14);
  box-shadow: 0 14rpx 30rpx rgba(65, 107, 173, 0.08);
}

.item-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 18rpx 0 18rpx 28rpx;
}

.item-right__audio,
.item-right__delete {
  width: 104rpx;
  height: 100%;
  background: rgba(103, 163, 255, 0.12);
  border-radius: 0 28rpx 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-right__delete > image {
  width: 30rpx;
  height: 40rpx;
}

.item-right__audio > image {
  width: 33rpx;
  height: 28rpx;
}

.item-right__delete {
  background: rgba(255, 112, 112, 0.12);
}
.item-right__delete:active {
  background: rgba(255, 112, 112, 0.20);
}

.item-right__audio:active {
  background: rgba(103, 163, 255, 0.22);
}

.item-left__word-text {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a2b49;
}

.item-left__word-usphone {
  margin-left: 22rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #7a8ca8;
}

.item-left__trans {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #5f6f88;
  width: 560rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-left__trans-tip {
  color: #9aa8ba;
}

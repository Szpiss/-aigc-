page {
  background: linear-gradient(180deg, #f4f9ff 0%, #eef5ff 38%, #f8fbff 100%);
}

.review-page {
  min-height: 100vh;
}

.review-hero {
  margin-top: 8rpx;
}

.review-hero__kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.review-hero__title,
.review-hero__subtitle {
  display: block;
}

.review-list {
  margin-top: 22rpx;
}

.onBottom {
  font-size: 24rpx;
  color: #7a8ca8;
  display: block;
  text-align: center;
  box-sizing: border-box;
  padding: 36rpx 0 64rpx 0;
}


.blank {
  display: flex;
  flex-direction: column;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
}

.blank-img {
  width: 267rpx;
  height: 200rpx;
}

.blank-text {
  margin-top: 34rpx;
  color: #1a2b49;
  font-size: 32rpx;
  font-weight: 700;
}

.blank-desc {
  margin-top: 12rpx;
  max-width: 560rpx;
  color: #7a8ca8;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

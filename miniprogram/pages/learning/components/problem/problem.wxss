problem {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.problem {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 32rpx 24rpx 0;
  padding: 42rpx 24rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 38rpx rgba(65, 107, 173, 0.12);
}

.problem-word {
  font-size: 58rpx;
  font-weight: 700;
  color: #1a2b49;
  max-width: 720rpx;
  overflow: hidden;
}

.problem-usphone {
  font-size: 28rpx;
  font-weight: 500;
  color: #7a8ca8;
  max-width: 650rpx;
  margin-top: 10rpx;
}

.problem-usphone__hidden {
  opacity: 0;
}

.problem-options {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 36rpx;
}

.option {
  width: 650rpx;
  min-height: 104rpx;
  background: rgba(246, 249, 255, 0.95);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 18rpx 0 28rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(124, 170, 232, 0.14);
}

.option-wrong {
  background: rgba(255, 112, 112, 0.14) !important;
}

.option-correct {
  background: rgba(60, 190, 150, 0.16) !important;
}

.option-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #203554;
  width: 560rpx;
}

.option-icon {
  width: 40rpx;
  height: 40rpx;
}

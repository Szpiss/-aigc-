problem {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.problem {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 32rpx 24rpx 0;
  padding: 42rpx 24rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 38rpx rgba(65, 107, 173, 0.12);
}

.problem--recognition {
  justify-content: center;
  padding-top: 58rpx;
  padding-bottom: 38rpx;
}

.problem-word {
  font-size: 58rpx;
  font-weight: 700;
  color: #1a2b49;
  max-width: 720rpx;
  overflow: hidden;
}

.problem-usphone {
  font-size: 28rpx;
  font-weight: 500;
  color: #7a8ca8;
  max-width: 650rpx;
  margin-top: 10rpx;
}

.problem-usphone__hidden {
  opacity: 0;
}

.problem-options {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 36rpx;
}

.option {
  width: 650rpx;
  min-height: 104rpx;
  background: rgba(246, 249, 255, 0.95);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 18rpx 0 28rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(124, 170, 232, 0.14);
}

.option-wrong {
  background: rgba(255, 112, 112, 0.14) !important;
}

.option-correct {
  background: rgba(60, 190, 150, 0.16) !important;
}

.option-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #203554;
  width: 560rpx;
}

.option-icon {
  width: 40rpx;
  height: 40rpx;
}

.recognition-meaning {
  width: 100%;
  box-sizing: border-box;
  min-height: 142rpx;
  margin-top: 34rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(246, 249, 255, 0.96);
  border: 1rpx solid rgba(124, 170, 232, 0.16);
}

.recognition-meaning--hidden {
  opacity: 0.42;
}

.recognition-meaning__label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #7a8ca8;
}

.recognition-meaning__text {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #203554;
}

.recognition-reveal {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #6ea1ff 0%, #7b7ff2 100%);
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 26rpx rgba(82, 118, 210, 0.18);
}

.recognition-actions {
  display: flex;
  width: 100%;
  margin-top: 28rpx;
}

.recognition-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.recognition-btn:not(:first-child) {
  margin-left: 18rpx;
}

.recognition-btn--known {
  background: linear-gradient(135deg, #6ea1ff 0%, #7b7ff2 100%);
  color: #fff;
}

.recognition-btn--unknown {
  background: rgba(255, 255, 255, 0.92);
  color: #52657f;
  border: 1rpx solid rgba(124, 170, 232, 0.24);
}

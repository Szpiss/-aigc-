page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: linear-gradient(180deg, #f4f9ff 0%, #eef5ff 38%, #f8fbff 100%);
}

.learning-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 0 20rpx;
}

.learning-mode {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(124, 170, 232, 0.14);
  box-shadow: 0 12rpx 28rpx rgba(65, 107, 173, 0.10);
}

.learning-mode__copy {
  display: flex;
  flex-direction: column;
}

.learning-mode__label {
  font-size: 21rpx;
  font-weight: 700;
  color: #7a8ca8;
}

.learning-mode__value {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #1a2b49;
}

.learning-mode__btn {
  min-width: 148rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(239, 246, 255, 0.95);
  color: #3d71bf;
  font-size: 23rpx;
  font-weight: 700;
}

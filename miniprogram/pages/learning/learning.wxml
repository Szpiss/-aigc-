<view class="learning-page">
  <view class="learning-mode">
    <view class="learning-mode__copy">
      <text class="learning-mode__label">当前模式</text>
      <text class="learning-mode__value">{{learningModeLabel}}</text>
    </view>
    <button class="learning-mode__btn" hover-class="touch-s" catchtap="onChangeMode">回首页切换</button>
  </view>

  <top-bar />

  <problem wordItem="{{$state.learning.wordList[$state.learning.wordsIndex]}}" bind:loadMoreWords="loadWordsData" />

  <footer-bar />
</view>

<!-- 加载 -->
<loading id="loading" />

<!-- 弹窗 -->
<toast id="toast" />

<!-- 复活、再来一局弹窗 -->
<popup />

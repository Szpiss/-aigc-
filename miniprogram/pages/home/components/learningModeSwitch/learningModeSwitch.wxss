.mode-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(124, 170, 232, 0.16);
  box-shadow: 0 14rpx 30rpx rgba(65, 107, 173, 0.10);
}

.mode-card__left {
  flex: 1;
  min-width: 0;
}

.mode-card__kicker,
.mode-card__title,
.mode-card__desc {
  display: block;
}

.mode-card__kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.mode-card__title {
  margin-top: 6rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: #1a2b49;
}

.mode-card__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #7a8ca8;
}

.mode-card__pill {
  margin-left: 22rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  box-shadow: 0 12rpx 24rpx rgba(72, 119, 201, 0.20);
}

.mode-card__pill-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
}

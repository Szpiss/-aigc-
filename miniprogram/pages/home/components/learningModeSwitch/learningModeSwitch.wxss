.mode-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(124, 170, 232, 0.16);
  box-shadow: 0 12rpx 24rpx rgba(65, 107, 173, 0.08);
}

.mode-card__left {
  flex: 1;
  min-width: 0;
}

.mode-card__main {
  display: flex;
  align-items: center;
}

.mode-card__kicker,
.mode-card__title,
.mode-card__desc {
  display: block;
}

.mode-card__kicker {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.mode-card__title {
  margin-left: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #1a2b49;
}

.mode-card__desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #7a8ca8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mode-card__pill {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  box-shadow: 0 10rpx 20rpx rgba(72, 119, 201, 0.18);
}

.mode-card__pill-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
}

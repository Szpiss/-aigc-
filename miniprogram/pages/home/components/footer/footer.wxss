.footer {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.footer__header {
  display: flex;
  flex-direction: column;
}

.footer__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2b49;
}

.footer__subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7d8ca3;
}

.footer__grid {
  display: flex;
  margin-top: 20rpx;
}

.footer-item {
  flex: 1;
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 0;
  border-radius: 28rpx;
  outline: none;
  box-shadow: 0 14rpx 28rpx rgba(65, 107, 173, 0.08);
}

.footer-item + .footer-item {
  margin-left: 20rpx;
}

.footer-item::after {
  border: 0;
}

.footer-item__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 84rpx;
  height: 48rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(91, 153, 240, 0.12);
}

.footer-item__icon--feedback {
  background: rgba(92, 197, 192, 0.12);
}

.footer-item__icon-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #3d6eb7;
}

.footer-item__content {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  text-align: left;
}

.footer-item__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #203554;
}

.footer-item__desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #7d8ca3;
}

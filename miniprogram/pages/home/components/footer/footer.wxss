.footer {
  display: flex;
  justify-content: space-between;
  padding: 0 48rpx;
  margin-top: 100rpx;
}

.footer-item {
  padding: 0;
  background: transparent;
  display: flex;
  align-items: center;
  width: 220rpx!important;
  border: 0;
  outline: none;
}

.footer-icon {
  width: 36rpx;
  height: 36rpx;
}

.footer-text {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(51, 51, 51, 1);
  margin-left: 24rpx;
}

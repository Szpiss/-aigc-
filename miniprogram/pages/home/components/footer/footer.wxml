<view class="footer">
  <view class="footer__header">
    <text class="footer__title">更多服务</text>
    <text class="footer__subtitle">查看排行、提交反馈，保持体验持续变好</text>
  </view>

  <view class="footer__grid">
    <button class="footer-item" catchtap="onToRanking" hover-class="touch-s">
      <view class="footer-item__icon">
        <text class="footer-item__icon-text">TOP</text>
      </view>
      <view class="footer-item__content">
        <text class="footer-item__title">排行榜</text>
        <text class="footer-item__desc">看看自己的词力位置</text>
      </view>
    </button>

    <button open-type="feedback" class="footer-item" hover-class="touch-s">
      <view class="footer-item__icon footer-item__icon--feedback">
        <text class="footer-item__icon-text">FEED</text>
      </view>
      <view class="footer-item__content">
        <text class="footer-item__title">建议反馈</text>
        <text class="footer-item__desc">告诉我们哪里还能更好</text>
      </view>
    </button>
  </view>
</view>

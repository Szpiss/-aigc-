<view class="footer">
  <view class="footer__header">
    <text class="footer__title">更多服务</text>
  </view>

  <view class="footer__grid">
    <button open-type="feedback" class="footer-item" hover-class="touch-s">
      <view class="footer-item__icon footer-item__icon--feedback">
        <text class="footer-item__icon-text">FEED</text>
      </view>
      <view class="footer-item__content">
        <text class="footer-item__title">建议反馈</text>
      </view>
    </button>

    <button class="footer-item" hover-class="touch-s" catchtap="onToSetting">
      <view class="footer-item__icon footer-item__icon--setting">
        <text class="footer-item__icon-text">SET</text>
      </view>
      <view class="footer-item__content">
        <text class="footer-item__title">设置</text>
      </view>
    </button>
  </view>
</view>

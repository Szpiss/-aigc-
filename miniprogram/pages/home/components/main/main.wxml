<view class="main">
  <view class="main__header">
    <text class="main__title">核心功能</text>
  </view>

  <!-- 单词对战模块 -->
  <button class="feature-card feature-card--hero" hover-class="touch-s" catchtap="onCombatModule">
    <view class="feature-card__badge">HOT</view>
    <view class="feature-card__icon feature-card__icon--combat">
      <text class="feature-card__icon-text">PK</text>
    </view>
    <view class="feature-card__content">
      <text class="feature-card__title">单词对战</text>
      <text class="feature-card__desc">好友对战、随机匹配，边玩边巩固记忆点</text>
    </view>
    <text class="feature-card__action">立即开始</text>
  </button>

  <view class="feature-grid">
    <!-- AIGC按钮：修改事件绑定为onAIGC -->
    <button class="feature-card feature-card--secondary" hover-class="touch-s" catchtap="onAIGC">
      <view class="feature-card__icon feature-card__icon--aigc">
        <text class="feature-card__icon-text">AI</text>
      </view>
      <view class="feature-card__content">
        <text class="feature-card__title">AIGC 学习助手</text>
        <text class="feature-card__desc">用智能问答陪你拆词、练句子、查疑难</text>
      </view>
    </button>

    <!-- 数据看板按钮 -->
    <button class="feature-card feature-card--secondary" hover-class="touch-s" catchtap="onToStatistics">
      <view class="feature-card__icon feature-card__icon--stats">
        <text class="feature-card__icon-text">DATA</text>
      </view>
      <view class="feature-card__content">
        <text class="feature-card__title">数据看板</text>
        <text class="feature-card__desc">查看学习次数、胜率和阶段表现变化</text>
      </view>
    </button>

    <!-- 词汇学习按钮 -->
    <button class="feature-card feature-card--secondary" hover-class="touch-s" catchtap="onChallengeWord">
      <view class="feature-card__icon feature-card__icon--daily">
        <text class="feature-card__icon-text">DAY</text>
      </view>
      <view class="feature-card__content">
        <text class="feature-card__title">词汇学习</text>
        <text class="feature-card__desc">用更轻量的日练节奏维持英语输入输出</text>
      </view>
    </button>

    <!-- 生词本按钮 -->
    <button class="feature-card feature-card--secondary" hover-class="touch-s" catchtap="onToUserWords">
      <view class="feature-card__icon feature-card__icon--review">
        <text class="feature-card__icon-text">WORD</text>
      </view>
      <view class="feature-card__content">
        <text class="feature-card__title">生词本</text>
        <text class="feature-card__desc">回收薄弱词汇，安排针对性复习任务</text>
      </view>
    </button>
  </view>
</view>

.main {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.main__header {
  display: flex;
  flex-direction: column;
  padding: 0 8rpx;
}

.main__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2b49;
}

.main__subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7d8ca3;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.feature-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100% !important;
  padding: 30rpx 28rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 30rpx;
  outline: none;
  background: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(65, 107, 173, 0.1);
}

.feature-card::after {
  border: 0;
}

.feature-card--hero {
  min-height: 212rpx;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #69a8ff 0%, #4e84e6 100%);
  box-shadow: 0 22rpx 40rpx rgba(72, 119, 201, 0.24);
}

.feature-card--secondary {
  width: 334rpx !important;
  min-height: 220rpx;
  margin-bottom: 18rpx;
  background: rgba(255, 255, 255, 0.94);
}

.feature-card__badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.92);
}

.feature-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 52rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(84, 134, 214, 0.12);
}

.feature-card__icon--combat {
  background: rgba(255, 255, 255, 0.22);
}

.feature-card__icon--aigc {
  background: rgba(98, 145, 255, 0.12);
}

.feature-card__icon--stats {
  background: rgba(92, 197, 192, 0.12);
}

.feature-card__icon--daily {
  background: rgba(255, 182, 90, 0.16);
}

.feature-card__icon--review {
  background: rgba(147, 116, 255, 0.12);
}

.feature-card__icon-text {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d6eb7;
}

.feature-card--hero .feature-card__icon-text {
  color: rgba(255, 255, 255, 0.95);
}

.feature-card__content {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  text-align: left;
}

.feature-card__title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #203554;
}

.feature-card--secondary .feature-card__title {
  font-size: 30rpx;
}

.feature-card--hero .feature-card__title {
  color: #ffffff;
}

.feature-card__desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #74849c;
}

.feature-card--hero .feature-card__desc {
  max-width: 380rpx;
  color: rgba(255, 255, 255, 0.82);
}

.feature-card__action {
  margin-top: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
}

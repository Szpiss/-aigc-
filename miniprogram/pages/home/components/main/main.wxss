/* 调整主容器样式，去掉固定高度限制，让内容自然排列 */
.main {
	display: flex;
	flex-direction: column;
	align-items: center; /* 水平居中按钮 */
	width: 750rpx;
	/* 移除固定高度，避免内容被压缩 */
	/* height: 560rpx; */
	margin-top: 64rpx;
	padding-bottom: 20rpx; /* 底部留出一些空间 */
  }
  
  /* 调整主按钮间距，增加垂直间隔 */
  .btn-oneline {
	position: relative;
	display: flex;
	align-items: center;
	width: 600rpx !important;
	height: 140rpx;
	background: rgba(141, 216, 255, 1);
	border-radius: 12rpx;
	padding: 0;
	border: 0;
	outline: none;
	margin-bottom: 25rpx; /* 增大按钮之间的间距 */
  }
  
  /* 保持其他样式不变 */
  .btn-oneline__icon {
	width: 64rpx;
	height: 64rpx;
	margin-left: 50rpx;
  }
  
  .btn-oneline__tag {
	position: absolute;
	top: 0;
	left: 488rpx;
	width: 64rpx;
	height: 33rpx;
  }
  
  .btn-oneline__text {
	display: flex;
	flex-direction: column;
	margin-left: 60rpx;
  }
  
  .oneline-text__title {
	text-align: left;
	font-size: 36rpx;
	font-weight: 500;
	color: rgba(255, 255, 255, 1);
  }
  
  .oneline-text__desc {
	text-align: left;
	font-size: 28rpx;
	font-weight: 500;
	color: rgba(238, 238, 238, 1);
  }
  
  .btn-pk > .btn-oneline__tag {
	height: 36rpx;
	width: 44rpx;
	left: 506rpx;
  }
  
  /* 调整下方两个按钮的容器样式 */
  .btn-two-wrap {
	display: flex;
	justify-content: space-between;
	padding: 0 74rpx;
	margin-top: 10rpx; /* 减小与上方按钮的距离 */
  }
  
  /* 下方两个按钮的样式保持不变，但通过容器的margin-top控制距离 */
  .btn-two {
	position: relative;
	width: 288rpx !important;
	height: 180rpx;
	background: rgba(141, 216, 255, 1);
	border-radius: 12rpx;
	padding: 0;
	border: 0;
	outline: none;
	/* 移除内联的top样式，改用容器的margin控制距离 */
  }
  
  /* 保持其他样式不变 */
  .btn-two__text {
	display: flex;
	flex-direction: column;
	margin-top: 24rpx;
	margin-left: 48rpx;
	text-align: left;
  }
  
  .btn-two__title {
	font-size: 32rpx;
	font-weight: 500;
	color: rgba(255, 255, 255, 1);
  }
  
  .btn-two__desc {
	font-size: 27rpx;
	font-weight: 500;
	color: rgba(238, 238, 238, 1);
  }
  
  .btn-two__icon {
	width: 69rpx;
	height: 64rpx;
	position: absolute;
	top: 108rpx;
	left: 189rpx;
  }
	  
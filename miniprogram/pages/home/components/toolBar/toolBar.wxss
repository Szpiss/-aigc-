.toolbar {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.toolbar__header {
  display: flex;
  flex-direction: column;
}

.toolbar__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a2b49;
}

.toolbar__subtitle {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #7d8ca3;
}

.toolbar__grid {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.quick-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 154rpx;
  padding: 20rpx 18rpx 18rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 14rpx 30rpx rgba(65, 107, 173, 0.08);
  border: 1rpx solid rgba(124, 170, 232, 0.12);
}

.quick-card + .quick-card {
  margin-left: 14rpx;
}

.quick-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quick-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  height: 42rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(91, 153, 240, 0.12);
}

.quick-card__icon--book {
  background: rgba(93, 196, 191, 0.12);
}

.quick-card__icon-text {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #406da9;
}

.quick-card__value {
  max-width: 190rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
  color: #315d9d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-card__title {
  margin-top: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #203554;
}

.quick-card__desc {
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.45;
  color: #7d8ca3;
}

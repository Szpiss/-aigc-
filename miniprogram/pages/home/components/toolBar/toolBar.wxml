<view class="toolbar">
  <view class="toolbar__header">
    <text class="toolbar__title">学习准备</text>
  </view>

  <view class="toolbar__grid">
    <view class="quick-card" catchtap="onTipCard">
      <view class="quick-card__top">
        <view class="quick-card__icon quick-card__icon--tip">
          <text class="quick-card__icon-text">TIP</text>
        </view>
        <text class="quick-card__value">{{$state.user.totalTip}} 张</text>
      </view>
      <text class="quick-card__title">提示卡</text>
      <text class="quick-card__desc">可用于对战和每日词汇，帮你稳住关键题目</text>
    </view>

    <view class="quick-card" catchtap="onSelectBook">
      <view class="quick-card__top">
        <view class="quick-card__icon quick-card__icon--book">
          <text class="quick-card__icon-text">BOOK</text>
        </view>
        <text class="quick-card__value">{{$state.book.shortName}}</text>
      </view>
      <text class="quick-card__title">当前词书</text>
      <text class="quick-card__desc">随时切换学习范围，让训练内容更贴合你的阶段</text>
    </view>
  </view>
</view>

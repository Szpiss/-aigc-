.user-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(245, 250, 255, 0.94) 100%);
  box-shadow: 0 20rpx 40rpx rgba(65, 107, 173, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.user-card__hero {
  display: flex;
  align-items: center;
}

.user-card__avatar-wrap {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
  border-radius: 50%;
  padding: 6rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, rgba(120, 181, 255, 0.24), rgba(255, 255, 255, 0.92));
}

.user-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(77, 123, 194, 0.18);
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-left: 28rpx;
}

.user-info__headline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.user-info__login {
  display: flex;
  flex-direction: column;
}

.user-info__login-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #4d7bc2;
}

.user-info__badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(103, 163, 255, 0.12);
}

.user-info__badge-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #3d71bf;
}

.user-info__nickname {
  max-width: 320rpx;
  line-height: 1.2;
  font-size: 38rpx;
  font-weight: 700;
  color: #1a2b49;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-info__summary {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6f8098;
}

.user-info__score {
  display: flex;
  align-items: baseline;
  margin-top: 18rpx;
}

.user-info__score-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #6f8098;
}

.user-info__score-value {
  margin-left: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #2f63b4;
}

.user-card__stats {
  display: flex;
  margin-top: 28rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(246, 249, 255, 0.95);
  border: 1rpx solid rgba(130, 170, 228, 0.14);
}

.stat-card + .stat-card {
  margin-left: 20rpx;
}

.stat-card--accent {
  background: linear-gradient(180deg, rgba(235, 245, 255, 0.98) 0%, rgba(245, 249, 255, 0.95) 100%);
}

.stat-card__label {
  font-size: 22rpx;
  color: #7b8aa3;
}

.stat-card__value {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #22395d;
}

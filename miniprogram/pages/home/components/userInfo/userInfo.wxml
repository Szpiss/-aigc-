<view class="user-card">
  <view class="user-card__hero">
    <view class="user-card__avatar-wrap">
      <!-- 主页头像信息，state 中有则显示 state 中数据，否则使用默认头像 -->
      <image wx:if="{{$state.user.avatar}}" class="user-avatar" src="{{$state.user.avatar}}" />
      <image wx:else class="user-avatar" src="./../../../../images/combat-default-avatar.png"></image>
    </view>

    <view class="user-info">
      <view class="user-info__headline">
        <!-- 主页用户昵称信息，state 中的显示优先级大于 opendata 优先级 -->
        <text wx:if="{{$state.user.nickname}}" class="user-info__nickname">{{$state.user.nickname}}</text>
        <view wx:else class="user-info__login" catchtap="onGetUserInfo">
          <text class="user-info__nickname">单词天天斗</text>
          <text class="user-info__login-text">点击登录同步学习进度</text>
        </view>

        <view class="user-info__actions">
          <button class="user-info__rank-btn" hover-class="touch-s" catchtap="onToRanking">
            <text class="user-info__rank-label">TOP</text>
            <text class="user-info__rank-text">排行榜</text>
          </button>
          <button class="user-info__setting-btn" hover-class="touch-s" catchtap="onToSetting">
            <text class="user-info__setting-text">设置</text>
          </button>
        </view>
      </view>

      <text class="user-info__summary">轻量复习、对战闯关、持续积累你的词力值</text>

      <view class="user-info__score">
        <text class="user-info__score-label">词力值</text>
        <text class="user-info__score-value">{{$state.user.experience}}</text>
      </view>
    </view>
  </view>

  <view class="user-card__stats">
    <view class="stat-card">
      <text class="stat-card__label">总对战</text>
      <text class="stat-card__value">{{$state.user.totalGames}} 局</text>
    </view>
    <view class="stat-card stat-card--accent">
      <text class="stat-card__label">累计胜利</text>
      <text class="stat-card__value">{{$state.user.winGames}} 局</text>
    </view>
  </view>
</view>

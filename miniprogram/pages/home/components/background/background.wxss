.bg {
  position: absolute;
  width: 100%;
  height: 100vh;
  left: 0;
  top: 0;
  z-index: -1;
  overflow: hidden;
}

.bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(0);
}

.bg-orb--primary {
  width: 480rpx;
  height: 480rpx;
  top: -120rpx;
  right: -100rpx;
  background: radial-gradient(circle, rgba(119, 181, 255, 0.34) 0%, rgba(119, 181, 255, 0) 72%);
}

.bg-orb--secondary {
  width: 360rpx;
  height: 360rpx;
  top: 420rpx;
  left: -140rpx;
  background: radial-gradient(circle, rgba(112, 220, 214, 0.22) 0%, rgba(112, 220, 214, 0) 76%);
}

.bg-orb--tertiary {
  width: 420rpx;
  height: 420rpx;
  top: 860rpx;
  right: -160rpx;
  background: radial-gradient(circle, rgba(160, 146, 255, 0.18) 0%, rgba(160, 146, 255, 0) 74%);
}

.home-setting {
  position: absolute;
  right: 28rpx;
  top: 178rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: 0 16rpx 30rpx rgba(65, 107, 173, 0.12);
}

.home-setting__icon {
  width: 36rpx;
  height: 36rpx;
}

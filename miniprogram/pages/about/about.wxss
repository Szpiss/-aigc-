page {
  background: linear-gradient(180deg, #f4f9ff 0%, #eef5ff 38%, #f8fbff 100%);
}

.about-page {
  min-height: 100vh;
}

.about-hero {
  margin-top: 8rpx;
}

.about-hero__kicker,
.about-hero__title,
.about-hero__subtitle {
  display: block;
}

.about-hero__kicker {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.about-card {
  margin-top: 24rpx;
}

.about-card__title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2b49;
}

.rich-content {
  box-sizing: border-box;
  padding: 0;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f6f88;
}

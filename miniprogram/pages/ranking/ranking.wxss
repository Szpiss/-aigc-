page {
  background: linear-gradient(180deg, #f4f9ff 0%, #eef5ff 38%, #f8fbff 100%);
  box-sizing: border-box;
  padding: 0 0 132rpx 0;
}

.ranking-page {
  min-height: 100vh;
}

.ranking-hero {
  margin-top: 8rpx;
}

.ranking-hero__kicker,
.ranking-hero__title,
.ranking-hero__subtitle {
  display: block;
}

.ranking-hero__kicker {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.ranking-list {
  margin-top: 20rpx;
}

.ranking-empty {
  margin-left: 0;
  margin-right: 0;
}

.mine {
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(65, 107, 173, 0.12);
  position: fixed;
  bottom: 0;
  left: 0;
  width: 750rpx;
  padding: 14rpx 20rpx 22rpx;
  box-sizing: border-box;
}

.info {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  padding: 18rpx 24rpx;
  margin-top: 14rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(124, 170, 232, 0.14);
  box-shadow: 0 12rpx 26rpx rgba(65, 107, 173, 0.08);
}

.info-num {
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-num__img {
  width: 33rpx;
  height: 40rpx;
}

.info-num__text {
  font-size: 30rpx;
  font-weight: 700;
  color: #8da0bb;
}

.avartar {
  width: 68rpx;
  height: 68rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(65, 107, 173, 0.12);
}

.nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2b49;
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
  text-overflow:ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.tag {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3d71bf;
  font-size: 20rpx;
  font-weight: 700;
  background: rgba(103, 163, 255, 0.12);
  box-sizing: border-box;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.score {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.score-img {
  width: 33rpx;
  height: 31rpx;
}

.score-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2f63b4;
  margin-left: 12rpx;
}

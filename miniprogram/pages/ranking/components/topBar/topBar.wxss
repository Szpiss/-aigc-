.top-bar {
  height: 76rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.86);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 26rpx rgba(65, 107, 173, 0.08);
  margin-top: 22rpx;
  padding: 8rpx;
  box-sizing: border-box;
}

.top-bar__tab {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: #7a8ca8;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.top-bar::before{
  display: none;
}

.active {
  color: #ffffff;
  font-weight: 700;
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
}

page {
  background: linear-gradient(180deg, #f4f9ff 0%, #eef5ff 38%, #f8fbff 100%);
}

.setting-page {
  min-height: 100vh;
}

.setting-hero {
  margin-top: 8rpx;
}

.setting-hero__kicker,
.setting-hero__title,
.setting-hero__subtitle {
  display: block;
}

.setting-hero__kicker {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.setting-group {
  margin-top: 24rpx;
}

.setting-group__title {
  display: block;
  margin: 0 8rpx 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1a2b49;
}

.card {
  width: 100%;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  padding: 10rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(124, 170, 232, 0.14);
  box-shadow: 0 16rpx 34rpx rgba(65, 107, 173, 0.10);
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(153, 153, 153, 1);
}

.card-item {
  display: flex;
  box-sizing: border-box;
  min-height: 88rpx;
  align-items: center;
}

.card-item:not(:first-child) {
  border-top: 1rpx solid rgba(124, 170, 232, 0.10);
}

.card-item__title {
  font-size: 29rpx;
  font-weight: 700;
  background: transparent!important;
  padding: 0;
  height: 72rpx;
  flex: 1;
  display: flex;
  align-items: center;
  color: #203554;
}

.card-item--danger .card-item__title {
  color: #d64d5b;
}

.card-item__desc {
  font-size: 25rpx;
  font-weight: 700;
  color: #7a8ca8;
  min-width: 70rpx;
  text-align: right;
}

.card-item__icon {
  width: 19rpx;
  height: 32rpx;
  margin-left: 24rpx;
}

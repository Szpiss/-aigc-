page {
  font-family: "DIN Alternate", "Avenir Next", "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
}

.header {
}

.header-icon {
}

.header-title {
}

.header-spacer {
}

.hero {
  margin-top: 8rpx;
}

.hero-kicker {
  margin-bottom: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.hero-title {
}

.hero-subtitle {
}

.panel {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

.mode-button {
  display: flex;
  align-items: center;
  width: 100% !important;
  min-height: 148rpx;
  margin: 0 0 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  padding: 26rpx 26rpx;
  box-sizing: border-box;
  border: 0;
  box-shadow: 0 16rpx 34rpx rgba(65, 107, 173, 0.10);
}

.mode-button::after {
  border: 0;
}

.mode-random {
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
}

.mode-friend {
  background: rgba(255, 255, 255, 0.96);
}

.mode-npc {
  background: rgba(255, 255, 255, 0.86);
}

.mode-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: rgba(103, 163, 255, 0.12);
}

.mode-random .mode-icon-wrap {
  background: rgba(255, 255, 255, 0.20);
}

.mode-icon {
  width: 56rpx;
  height: 56rpx;
}

.mode-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
  text-align: left;
}

.mode-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2b49;
}

.mode-random .mode-title {
  color: #ffffff;
}

.mode-desc {
  font-size: 22rpx;
  line-height: 1.45;
  color: #7a8ca8;
  margin-top: 6rpx;
}

.mode-random .mode-desc {
  color: rgba(255, 255, 255, 0.82);
}

.mode-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #3d71bf;
  background: rgba(103, 163, 255, 0.12);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.mode-random .mode-tag {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.20);
}

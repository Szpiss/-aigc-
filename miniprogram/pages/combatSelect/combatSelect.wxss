page {
  background: #f4f6ff;
  font-family: "DIN Alternate", "Avenir Next", "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6f8ff 0%, #eef2ff 60%, #f9fbff 100%);
}

.header {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.header-icon {
  width: 44rpx;
  height: 44rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1b2b52;
  margin-left: 16rpx;
}

.header-spacer {
  flex: 1;
}

.hero {
  margin: 12rpx 32rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e7f1ff 0%, #f1e8ff 100%);
  box-shadow: 0 12rpx 24rpx rgba(122, 134, 255, 0.15);
}

.hero-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2f4a;
}

.hero-subtitle {
  font-size: 22rpx;
  color: #6b6f8f;
  margin-top: 8rpx;
}

.panel {
  margin: 28rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: 40rpx;
}

.mode-button {
  display: flex;
  align-items: center;
  width: 100%;
  height: 140rpx;
  border-radius: 18rpx;
  background: #8dd8ff;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 0;
}

.mode-friend {
  background: #7bb7ff;
}

.mode-npc {
  background: #7b8bff;
}

.mode-icon {
  width: 64rpx;
  height: 64rpx;
}

.mode-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
  text-align: left;
}

.mode-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.mode-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.mode-tag {
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

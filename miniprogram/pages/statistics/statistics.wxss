page {
  font-family: "DIN Alternate", "Avenir Next", "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.header {
}

.header-icon {
}

.header-title {
}

.header-spacer {
}

.hero {
  margin-top: 8rpx;
}

.hero-kicker {
  margin-bottom: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.hero-title {
}

.hero-subtitle {
}

.tabs {
  margin-top: 24rpx;
  display: flex;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  padding: 8rpx;
  box-shadow: 0 12rpx 26rpx rgba(65, 107, 173, 0.08);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6d7798;
  padding: 12rpx 0;
  border-radius: 999rpx;
}

.tab-active {
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  color: #ffffff;
  font-weight: 600;
}

.section {
  margin-top: 20rpx;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 48.6%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(124, 170, 232, 0.14);
  box-shadow: 0 12rpx 26rpx rgba(65, 107, 173, 0.08);
}

.card-label {
  font-size: 22rpx;
  color: #8891b5;
}

.card-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c3454;
  margin-top: 8rpx;
}

.card-unit {
  font-size: 22rpx;
  margin-left: 6rpx;
  color: #7a84a6;
}

.effect-card,
.chart-card,
.detail-card {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(124, 170, 232, 0.14);
  box-shadow: 0 16rpx 34rpx rgba(65, 107, 173, 0.10);
}

.effect-list {
  display: flex;
  flex-direction: column;
}

.effect-item {
  display: flex;
  align-items: center;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96), rgba(250, 247, 255, 0.96));
  margin-top: 12rpx;
}

.effect-label {
  flex: 1;
  font-size: 22rpx;
  font-weight: 700;
  color: #52617f;
}

.effect-value {
  min-width: 128rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 800;
  color: #2f63b4;
}

.effect-desc {
  display: block;
  width: 210rpx;
  margin-left: 18rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #8a95b5;
}

.chart-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #29324a;
}

.chart-unit {
  font-size: 20rpx;
  color: #9aa3c2;
}

.bar-chart {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 220rpx;
}

.bar-item {
  width: 68rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-value {
  font-size: 20rpx;
  color: #6a74a6;
  margin-bottom: 6rpx;
}

.bar {
  width: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #69a8ff, #6676ee);
  box-shadow: 0 10rpx 18rpx rgba(83, 120, 255, 0.32);
}

.bar-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #9aa3c2;
}

.detail-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #29324a;
  margin-bottom: 16rpx;
}

.detail-list {
  display: flex;
  flex-direction: column;
}

.detail-item {
  display: flex;
  align-items: center;
  background: #f6f7ff;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  font-size: 22rpx;
  color: #5b6485;
  margin-top: 14rpx;
}

.detail-date {
  width: 120rpx;
  font-weight: 600;
  color: #3b4466;
}

.detail-meta {
  flex: 1;
  text-align: right;
}

.record-item {
  position: relative;
  padding: 18rpx 18rpx 18rpx 22rpx;
  background: #f6f7ff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  margin-top: 14rpx;
}

.record-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-book {
  font-size: 26rpx;
  font-weight: 600;
  color: #2b3454;
}

.record-type {
  font-size: 20rpx;
  color: #7a84a6;
}

.record-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #5f6b90;
  margin-top: 8rpx;
}

.record-score {
  font-weight: 600;
}

.record-time {
  font-size: 20rpx;
}

.record-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #ffffff;
}

.badge-win {
  background: #32b68a;
}

.badge-lose {
  background: #d64d5b;
}

.empty {
  text-align: center;
  font-size: 24rpx;
  color: #98a0bf;
  padding: 24rpx 0;
}

.weak-list {
  display: flex;
  flex-direction: column;
}

.weak-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f6f7ff;
  font-size: 22rpx;
  color: #4a5475;
  margin-top: 12rpx;
}

.weak-word {
  font-weight: 600;
  color: #2d3558;
}

.weak-score {
  color: #7a84a6;
}

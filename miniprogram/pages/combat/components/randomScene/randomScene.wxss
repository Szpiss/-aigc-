.userinfo {
  margin: 0 auto;
  position: relative;
  width: 480rpx;
  height: 480rpx;
  margin-top: 8vh;
}

.userinfo-avatar {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  left: 180rpx;
  top: 180rpx;
}

.circle-in {
  position: absolute;
  width: 287rpx;
  height: 287rpx;
  left: 96.5rpx;
  top: 96.5rpx;
}

.circle-out {
  position: absolute;
  width: 480rpx;
  height: 480rpx;
  left: 0;
  top: 0;
}

.matching {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.matching-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2b49;
  margin-top: 32rpx;
}

.matching-desc {
  font-size: 24rpx;
  font-weight: 500;
  color: #7a8ca8;
  margin-top: 16rpx;
}

.matching-button {
  width: 480rpx !important;
  height: 80rpx;
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  border-radius: 64rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx rgba(72, 119, 201, 0.22);
}

.matched {
  display: block;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #1a2b49;
  margin-top: 32rpx;
}

page {
  overflow: hidden;
}

.users {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  min-height: 420rpx;
  margin-top: 96rpx;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 50%;
  margin: 0 10rpx;
  padding: 36rpx 18rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 34rpx rgba(65, 107, 173, 0.10);
}

.userinfo-avatar {
  width: 165rpx;
  height: 165rpx;
  border-radius: 50%;
}

.userinfo-nickname {
  margin-top: 28rpx;
  font-size: 32rpx;
  color: #1a2b49;
  font-weight: 700;
}

.userinfo-grade,
.userinfo-winRate {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #7a8ca8;
  font-weight: 500;
}

.userinfo-winRate {
  margin-top: 24rpx;
}

.button-container {
  margin-top: 44rpx;
}

.button {
  width: 480rpx !important;
  height: 80rpx;
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  border-radius: 64rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(72, 119, 201, 0.22);
}

.pk-icon {
  display: block;
  width: 350rpx;
  height: 160rpx;
  margin: 64rpx auto 0;
}

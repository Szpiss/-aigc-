page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #f4f9ff 0%, #eef5ff 38%, #f8fbff 100%);
}

.header {
  position: relative;
  display: flex;
  align-items: center;
  width: 750rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.header-icon {
  width: 44rpx;
  height: 44rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2b49;
  margin-left: 16rpx;
}

.header-bgm-setting {
  height: 48rpx;
  width: 48rpx;
  position: absolute;
  top: 50%;
  transform: translateY(-24rpx);
  right: 48rpx;
}

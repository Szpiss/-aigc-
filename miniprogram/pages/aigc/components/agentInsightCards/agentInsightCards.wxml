<view class="insight-board">
  <view class="insight-board__header">
    <view>
      <text class="insight-board__kicker">Agent Modules</text>
      <text class="insight-board__title">智能建议卡片</text>
    </view>
    <view class="insight-board__status" wx:if="{{loading}}">同步中</view>
  </view>

  <view class="insight-tabs">
    <button class="insight-tab {{activeScene === 'learning' ? 'insight-tab--active' : ''}}" data-scene="learning" hover-class="touch-s" catchtap="onSwitchScene">学习建议</button>
    <button class="insight-tab {{activeScene === 'battle' ? 'insight-tab--active' : ''}}" data-scene="battle" hover-class="touch-s" catchtap="onSwitchScene">对战复盘</button>
  </view>

  <view class="insight-card insight-card--learning">
    <view class="insight-card__top">
      <view class="insight-card__badge">LEARN</view>
      <text class="insight-card__title">学习建议</text>
    </view>
    <view class="insight-row">
      <text class="insight-row__label">当前问题</text>
      <text class="insight-row__value">{{learningInsight.problem}}</text>
    </view>
    <view class="insight-row">
      <text class="insight-row__label">原因分析</text>
      <text class="insight-row__value">{{learningInsight.reason}}</text>
    </view>
    <view class="insight-row">
      <text class="insight-row__label">建议行动</text>
      <text class="insight-row__value">{{learningInsight.action}}</text>
    </view>
    <button class="insight-card__btn insight-card__btn--primary" hover-class="touch-s" catchtap="onGenerateLearning">生成学习建议</button>
  </view>

  <view class="insight-card insight-card--battle">
    <view class="insight-card__top">
      <view class="insight-card__badge insight-card__badge--battle">BATTLE</view>
      <text class="insight-card__title">对战复盘</text>
    </view>
    <view class="battle-grid">
      <view class="battle-metric">
        <text class="battle-metric__label">最近结果</text>
        <text class="battle-metric__value">{{battleInsight.result}}</text>
      </view>
      <view class="battle-metric">
        <text class="battle-metric__label">正误情况</text>
        <text class="battle-metric__value">{{battleInsight.accuracy}}</text>
      </view>
    </view>
    <view class="insight-row">
      <text class="insight-row__label">失误类型</text>
      <text class="insight-row__value">{{battleInsight.mistake}}</text>
    </view>
    <view class="insight-row">
      <text class="insight-row__label">复盘总结</text>
      <text class="insight-row__value">{{battleInsight.summary}}</text>
    </view>
    <button class="insight-card__btn insight-card__btn--secondary" hover-class="touch-s" catchtap="onGenerateBattle">复盘最近一场</button>
  </view>

  <view class="insight-card">
    <view class="insight-card__top">
      <view class="insight-card__badge insight-card__badge--weak">WEAK</view>
      <text class="insight-card__title">薄弱词汇</text>
    </view>
    <view class="weak-list" wx:if="{{weakWords.length}}">
      <view class="weak-word" wx:for="{{weakWords}}" wx:key="word">
        <text class="weak-word__name">{{item.word}}</text>
        <text class="weak-word__score">掌握度 {{item.mastery}}%</text>
      </view>
    </view>
    <view class="insight-empty" wx:else>暂无薄弱词数据，完成词汇学习或对战后会自动沉淀。</view>
    <button class="insight-card__btn insight-card__btn--ghost" hover-class="touch-s" catchtap="onStartWeakTraining">开始薄弱词训练</button>
  </view>

  <view class="insight-card">
    <view class="insight-card__top">
      <view class="insight-card__badge insight-card__badge--plan">NEXT</view>
      <text class="insight-card__title">下一步计划</text>
    </view>
    <view class="next-action" wx:for="{{nextActions}}" wx:key="*this">
      <text class="next-action__index">{{index + 1}}</text>
      <text class="next-action__text">{{item}}</text>
    </view>
  </view>
</view>

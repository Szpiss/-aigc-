.insight-board {
  margin-top: 20rpx;
}

.insight-board__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.insight-board__kicker,
.insight-board__title {
  display: block;
}

.insight-board__kicker {
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #4b78c8;
}

.insight-board__title {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #1a2b49;
}

.insight-board__status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(103, 163, 255, 0.14);
  font-size: 20rpx;
  font-weight: 700;
  color: #3d71bf;
}

.insight-tabs {
  display: flex;
  margin-top: 18rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.70);
  box-shadow: 0 10rpx 22rpx rgba(65, 107, 173, 0.08);
}

.insight-tab {
  flex: 1;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: #6f8098;
  font-size: 22rpx;
  font-weight: 800;
}

.insight-tab::after,
.insight-card__btn::after {
  border: 0;
}

.insight-tab--active {
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(72, 119, 201, 0.18);
}

.insight-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(124, 170, 232, 0.14);
  box-shadow: 0 14rpx 30rpx rgba(65, 107, 173, 0.09);
}

.insight-card--learning {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(242, 248, 255, 0.94) 100%);
}

.insight-card--battle {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 244, 255, 0.94) 100%);
}

.insight-card__top {
  display: flex;
  align-items: center;
}

.insight-card__badge {
  min-width: 68rpx;
  padding: 7rpx 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(103, 163, 255, 0.14);
  color: #3d71bf;
  font-size: 17rpx;
  font-weight: 800;
  text-align: center;
}

.insight-card__badge--battle {
  background: rgba(124, 115, 255, 0.14);
  color: #5b62d6;
}

.insight-card__badge--weak {
  background: rgba(255, 185, 93, 0.18);
  color: #a66a17;
}

.insight-card__badge--plan {
  background: rgba(92, 197, 192, 0.14);
  color: #23817d;
}

.insight-card__title {
  margin-left: 12rpx;
  font-size: 27rpx;
  font-weight: 800;
  color: #1f3558;
}

.insight-row {
  margin-top: 18rpx;
}

.insight-row__label,
.insight-row__value {
  display: block;
}

.insight-row__label {
  font-size: 20rpx;
  font-weight: 800;
  color: #4d7bc2;
}

.insight-row__value {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #53657f;
}

.battle-grid {
  display: flex;
  margin-top: 18rpx;
}

.battle-metric {
  flex: 1;
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.70);
}

.battle-metric + .battle-metric {
  margin-left: 14rpx;
}

.battle-metric__label,
.battle-metric__value {
  display: block;
}

.battle-metric__label {
  font-size: 19rpx;
  color: #7a8ca8;
}

.battle-metric__value {
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: #1a2b49;
}

.weak-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.weak-word {
  display: flex;
  flex-direction: column;
  min-width: 190rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 16rpx;
  border-radius: 20rpx;
  background: rgba(244, 249, 255, 0.86);
}

.weak-word__name {
  font-size: 25rpx;
  font-weight: 800;
  color: #1a2b49;
}

.weak-word__score {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #7a8ca8;
}

.insight-empty {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(244, 249, 255, 0.86);
  font-size: 23rpx;
  line-height: 1.5;
  color: #7a8ca8;
}

.next-action {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.next-action__index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(103, 163, 255, 0.14);
  color: #3d71bf;
  font-size: 20rpx;
  font-weight: 800;
}

.next-action__text {
  margin-left: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #53657f;
}

.insight-card__btn {
  width: 100%;
  height: 66rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.insight-card__btn--primary {
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  color: #ffffff;
}

.insight-card__btn--secondary {
  background: rgba(103, 132, 255, 0.13);
  color: #5264d9;
}

.insight-card__btn--ghost {
  background: rgba(255, 255, 255, 0.92);
  color: #2f63b4;
  border: 1rpx solid rgba(100, 150, 220, 0.18);
}

<view class="agent-page">
  <view class="agent-shell">
    <view class="agent-topbar" style="{{topBarStyle}}">
      <view class="agent-topbar__content" style="{{topBarContentStyle}}">
        <button class="topbar-menu" hover-class="touch-s" catchtap="onToggleSidebar">☰</button>
        <text class="topbar-title">{{moduleTitle}}</text>
        <button class="topbar-home" hover-class="touch-s" catchtap="onBack">首页</button>
      </view>
    </view>

    <view class="drawer-mask {{sidebarOpen ? 'drawer-mask--show' : ''}}" catchtap="onCloseSidebar"></view>
    <view class="agent-drawer {{sidebarOpen ? 'agent-drawer--open' : ''}}" style="{{drawerStyle}}">
      <view class="drawer-head">
        <text class="drawer-kicker">AI Agent</text>
        <text class="drawer-title">学习导航</text>
      </view>
      <view class="drawer-list">
        <button
          wx:for="{{navItems}}"
          wx:key="key"
          class="drawer-item {{activeModule === item.key ? 'drawer-item--active' : ''}}"
          data-module="{{item.key}}"
          hover-class="touch-s"
          catchtap="onNavTap"
        >
          <text class="drawer-item__icon">{{item.icon}}</text>
          <text class="drawer-item__label">{{item.label}}</text>
        </button>
      </view>
    </view>

    <view class="context-error" wx:if="{{contextError}}">
      <text>{{contextError}}</text>
      <button hover-class="touch-s" catchtap="refreshAgentContext">重试</button>
    </view>

    <view class="agent-content">
      <view wx:if="{{activeModule === 'home'}}" class="chat-page">
        <view class="chat-host">
          <agent-ui
            id="agent-ui"
            layoutHeight="{{agentLayoutHeight}}"
            agentConfig="{{agentConfig}}"
            showBotAvatar="{{showBotAvatar}}"
            chatMode="{{chatMode}}"
            modelConfig="{{modelConfig}}"
            envShareConfig="{{envShareConfig}}"
          ></agent-ui>
        </view>
      </view>

      <scroll-view wx:else class="module-scroll" scroll-y="{{true}}" enable-flex="{{true}}">
        <view wx:if="{{activeModule === 'vocabulary'}}" class="module-page">
          <view class="vocab-hero">
            <text class="hero-kicker">Vocabulary Mode</text>
            <text class="hero-title">选择词汇学习模式</text>
            <text class="hero-subtitle">从日常练习到词汇检测，选择最适合当前节奏的一轮。</text>
          </view>

          <view class="mode-list">
            <button class="mode-button mode-daily" data-module="daily-practice" hover-class="touch-s" catchtap="onWorkspaceAction">
              <view class="mode-icon-wrap">
                <text class="mode-icon">练</text>
              </view>
              <view class="mode-text">
                <text class="mode-title">日常练习</text>
                <text class="mode-desc">保留 5 词演示，也可按 25 / 50 / 100 词完成整轮练习</text>
              </view>
              <text class="mode-tag">练习</text>
            </button>

            <button class="mode-button mode-test" data-module="vocab-test" hover-class="touch-s" catchtap="onWorkspaceAction">
              <view class="mode-icon-wrap">
                <text class="mode-icon">测</text>
              </view>
              <view class="mode-text">
                <text class="mode-title">词汇检测</text>
                <text class="mode-desc">设置错误上限，完成词汇掌握检测</text>
              </view>
              <text class="mode-tag">检测</text>
            </button>
          </view>
        </view>

        <view wx:elif="{{activeModule === 'daily-practice' || activeModule === 'vocab-test'}}" class="module-page">
          <view wx:if="{{agentLearningSummary}}" class="summary-card">
            <text class="page-title">{{agentLearningSummary.title}}</text>
            <text class="page-desc">{{agentLearningSummary.subtitle}}</text>

            <view class="summary-grid">
              <view class="summary-stat">
                <text class="summary-stat__label">{{agentLearningType === 'test' ? '完成 / 选择' : '完成词数'}}</text>
                <text wx:if="{{agentLearningType === 'test'}}" class="summary-stat__value">{{agentLearningSummary.total}} / {{agentLearningSummary.requested}}</text>
                <text wx:else class="summary-stat__value">{{agentLearningSummary.total}}</text>
              </view>
              <view wx:if="{{agentLearningType === 'test'}}" class="summary-stat">
                <text class="summary-stat__label">实际检测</text>
                <text class="summary-stat__value">{{agentLearningSummary.actual}}</text>
              </view>
              <view class="summary-stat">
                <text class="summary-stat__label">{{selectedLearningMode === 'recognition' ? '认识' : '正确'}}</text>
                <text class="summary-stat__value">{{agentLearningSummary.correct}}</text>
              </view>
              <view class="summary-stat">
                <text class="summary-stat__label">{{selectedLearningMode === 'recognition' ? '不认识' : '错误'}}</text>
                <text class="summary-stat__value">{{agentLearningSummary.wrong}}</text>
              </view>
              <view class="summary-stat">
                <text class="summary-stat__label">{{selectedLearningMode === 'recognition' ? '认识率' : '正确率'}}</text>
                <text class="summary-stat__value">{{agentLearningSummary.rate}}%</text>
              </view>
            </view>

            <view wx:if="{{agentLearningType === 'test'}}" class="limit-note">本轮错误上限：{{agentLearningSummary.wrongLimit}} 个</view>
            <button class="primary-action" hover-class="touch-s" catchtap="onResetAgentLearning">{{agentLearningType === 'test' ? '再测一次' : '再练一轮'}}</button>
          </view>

          <view wx:elif="{{!agentLearningStarted}}" class="setup-card">
            <view class="page-head">
              <text class="page-title">{{activeModule === 'vocab-test' ? '词汇检测' : '日常练习'}}</text>
              <text class="page-desc">{{activeModule === 'vocab-test' ? '选择检测词数、检测模式和错误上限。' : '选择本轮词数和背词方式。'}}</text>
            </view>

            <view class="setup-section">
              <text class="setup-label">{{activeModule === 'vocab-test' ? '检测词数' : '选择词数'}}</text>
              <view class="segmented">
                <button
                  wx:for="{{activeModule === 'vocab-test' ? testWordCounts : practiceCounts}}"
                  wx:key="*this"
                  class="segment {{(activeModule === 'vocab-test' ? selectedTestWordCount : selectedPracticeCount) === item ? 'segment--active' : ''}}"
                  data-count="{{item}}"
                  data-target="{{activeModule === 'vocab-test' ? 'test' : 'practice'}}"
                  hover-class="touch-s"
                  catchtap="onSelectCount"
                >{{item}} 词</button>
              </view>
            </view>

            <view class="setup-section" wx:if="{{activeModule === 'vocab-test'}}">
              <text class="setup-label">错误上限</text>
              <view class="segmented">
                <button
                  wx:for="{{wrongLimitOptions}}"
                  wx:key="*this"
                  class="segment {{selectedWrongLimit === item ? 'segment--active' : ''}}"
                  data-limit="{{item}}"
                  hover-class="touch-s"
                  catchtap="onSelectWrongLimit"
                >错 {{item}} 个结束</button>
              </view>
            </view>

            <view class="setup-section">
              <text class="setup-label">{{activeModule === 'vocab-test' ? '检测模式' : '学习方式'}}</text>
              <view class="mode-options">
                <button
                  wx:for="{{vocabularyModeOptions}}"
                  wx:key="value"
                  class="mode-option {{selectedLearningMode === item.value ? 'mode-option--active' : ''}}"
                  data-mode="{{item.value}}"
                  hover-class="touch-s"
                  catchtap="onSelectLearningMode"
                >
                  <text class="mode-option__title">{{item.label}}</text>
                  <text class="mode-option__desc">{{item.desc}}</text>
                </button>
              </view>
            </view>

            <view class="setup-error" wx:if="{{agentLearningError}}">{{agentLearningError}}</view>
            <button class="primary-action" loading="{{agentLearningLoading}}" data-type="{{activeModule === 'vocab-test' ? 'test' : 'daily'}}" hover-class="touch-s" catchtap="onStartAgentLearning">
              {{agentLearningLoading ? '加载题目中' : (activeModule === 'vocab-test' ? '开始检测' : '开始学习')}}
            </button>
          </view>

          <view wx:else class="embedded-learning">
            <top-bar />
            <problem wordItem="{{$state.learning.wordList[$state.learning.wordsIndex]}}" bind:sessionFinish="onAgentSessionFinish" />
            <footer-bar />
          </view>
        </view>

        <view wx:elif="{{activeModule === 'battle-review'}}" class="module-page">
          <view class="page-head">
            <text class="page-title">对战复盘</text>
            <text class="page-desc">根据最近对战表现，总结失误原因和下一局策略。</text>
          </view>

          <view class="battle-summary">
            <view class="battle-summary__metric">
              <text>最近结果</text>
              <text class="battle-summary__value">{{battleInsight.result}}</text>
            </view>
            <view class="battle-summary__metric">
              <text>正误情况</text>
              <text class="battle-summary__value">{{battleInsight.accuracy}}</text>
            </view>
          </view>

          <view class="analysis-card">
            <text class="analysis-card__title">复盘内容</text>
            <text class="analysis-card__body">{{battleInsight.summary}}</text>
            <text class="analysis-card__body">{{battleInsight.mistake}}</text>
          </view>

          <button class="primary-action" hover-class="touch-s" catchtap="onGenerateCombatReview">重新复盘</button>
        </view>

        <view wx:elif="{{activeModule === 'suggestions'}}" class="module-page">
          <view class="page-head">
            <text class="page-title">学习建议</text>
            <text class="page-desc">根据学习记录和薄弱词，生成下一步练习安排。</text>
          </view>

          <view class="analysis-card">
            <text class="analysis-card__title">{{learningInsight.problem}}</text>
            <text class="analysis-card__body">{{learningInsight.reason}}</text>
            <text class="analysis-card__body">{{learningInsight.action}}</text>
          </view>

          <button class="primary-action" hover-class="touch-s" catchtap="onGenerateLearningAdvice">重新生成</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <loading id="loading" />
  <toast id="toast" />
</view>

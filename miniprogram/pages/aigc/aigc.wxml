<!-- pages/aigc/aigc.wxml -->
<view class="doubao-container">
  <!-- 顶部导航栏（极简风格） -->
  <view class="doubao-nav">
    <image 
      class="doubao-back" 
      src="/images/combat-back.png" 
      bindtap="handleBack"
    />
    <text class="doubao-title">智能英语学习助手</text>
  </view>

  <!-- 聊天内容区域（核心滚动区） -->
  <scroll-view 
    class="doubao-chat"
    scroll-y
    scroll-with-animation
    scroll-top="{{scrollTop}}"
    bindscrolltolower="handleLoadMore"
  >
    <!-- 系统欢迎语（首次进入显示） -->
    <view class="doubao-system-msg" wx:if="{{!hasHistory}}">
      <text>你好～我是你的英语学习助手，能帮你：</text>
      <text> 1. 单词解析  2. 语法纠错  3. 翻译润色</text>
      <text> 4. 口语陪练  5. 作文批改</text>
    </view>

    <!-- 聊天记录循环 -->
    <block wx:for="{{messageList}}" wx:key="id">
      <!-- 用户消息 -->
      <view class="doubao-msg doubao-user" wx:if="{{item.role === 'user'}}">
        <view class="doubao-bubble doubao-user-bubble">
          <text>{{item.content}}</text>
        </view>
      </view>
      <!-- AI消息 -->
      <view class="doubao-msg doubao-ai" wx:else>
        <image class="doubao-avatar" src="/images/test.png"></image>
        <view class="doubao-bubble doubao-ai-bubble">
          <text>{{item.content}}</text>
        </view>
      </view>
    </block>

    <!-- 加载中提示（AI思考时） -->
    <view class="doubao-loading" wx:if="{{isLoading}}">
      <text class="dot" wx:for="{{[1,2,3]}}" wx:key="*this">.</text>
    </view>
  </scroll-view>

  <!-- 底部交互栏（输入+发送） -->
  <view class="doubao-footer">
    <input 
      class="doubao-input"
      placeholder="输入你的英语问题..."
      value="{{inputValue}}"
      bindinput="handleInput"
      bindconfirm="handleSend"
    />
    <button 
      class="doubao-send"
      bindtap="handleSend"
      disabled="{{!inputValue || isLoading}}"
    >
      发送
    </button>
  </view>
</view>
<view class="page">
  <view class="action-panel">
    <view class="action-title">ADAL 智能学习助手</view>
    <view class="action-subtitle">基于你的学习计划与对战数据生成建议</view>
    <view class="action-buttons">
      <button class="action-btn" hover-class="btn-hover" catchtap="onGenerateLearningAdvice">生成学习建议</button>
      <button class="action-btn action-btn-secondary" hover-class="btn-hover" catchtap="onGenerateCombatReview">生成对战复盘</button>
    </view>
  </view>

  <view class="back" catchtap="onBack">
    <image class="back-icon" src="./../../images/combat-back.png" />
    <text class="back-text">返回首页</text>
  </view>

  <agent-ui id="agent-ui" agentConfig="{{agentConfig}}" showBotAvatar="{{showBotAvatar}}" chatMode="{{chatMode}}" modelConfig="{{modelConfig}}" envShareConfig="{{envShareConfig}}">
  </agent-ui>
</view>
.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.aigc-top {
  position: relative;
  padding: 18rpx 24rpx 12rpx;
  box-sizing: border-box;
  z-index: 2;
}

.action-panel {
  position: relative;
  padding: 24rpx 24rpx 22rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #e4f0ff 0%, #f2eaff 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 14rpx 30rpx rgba(80, 120, 200, 0.12);
}

.action-copy {
  padding-right: 170rpx;
  box-sizing: border-box;
}

.action-kicker {
  margin-bottom: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2b49;
  line-height: 1.25;
}

.action-subtitle {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: #6f8098;
}

.scenario-list {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.scenario-card {
  width: 48%;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.64);
}

.scenario-title,
.scenario-desc {
  display: block;
}

.scenario-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #1f3558;
}

.scenario-desc {
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 28rpx;
  color: #72839c;
}

.action-buttons {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
}

.action-btn {
  width: 49% !important;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
}

.action-btn::after {
  border: 0;
}

.action-btn-primary {
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(72, 119, 201, 0.22);
}

.action-btn-secondary {
  background: rgba(255, 255, 255, 0.88);
  color: #2f63b4;
  border: 1rpx solid rgba(100, 150, 220, 0.18);
}

.back {
  position: absolute;
  top: 36rpx;
  right: 42rpx;
  width: 162rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 14rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(26, 32, 54, 0.12);
}

.back-icon {
  width: 28rpx;
  height: 28rpx;
}

.back-text {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #2d2f4a;
}

.agent-host {
  width: 750rpx;
  height: calc(100vh - 286rpx);
  overflow: hidden;
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -10rpx 30rpx rgba(65, 107, 173, 0.10);
}

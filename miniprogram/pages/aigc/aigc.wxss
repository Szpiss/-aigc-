/* pages/aigc/aigc.wxss */
.doubao-container {
	display: flex;
	flex-direction: column;
	height: 100vh;
	background-color: #f9fafc;
	font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  }
  
  /* 顶部导航栏 */
  .doubao-nav {
	display: flex;
	align-items: center;
	height: 88rpx;
	padding: 0 32rpx;
	background-color: #fff;
	border-bottom: 1px solid #eee;
  }
  .doubao-back {
	width: 40rpx;
	height: 40rpx;
	margin-right: 20rpx;
  }
  .doubao-title {
	font-size: 36rpx;
	font-weight: 600;
	color: #333;
  }
  
  /* 聊天内容区 */
  .doubao-chat {
	flex: 1;
	padding: 32rpx;
	box-sizing: border-box;
	overflow-y: auto;
  }
  .doubao-system-msg {
	margin: 24rpx 0;
	padding: 20rpx;
	background-color: #f2f3f5;
	border-radius: 16rpx;
	font-size: 28rpx;
	color: #666;
	line-height: 44rpx;
  }
  
  /* 消息项通用样式 */
  .doubao-msg {
	display: flex;
	margin: 32rpx 0;
  }
  .doubao-bubble {
	max-width: 65%;
	padding: 24rpx 32rpx;
	border-radius: 24rpx;
	font-size: 32rpx;
	line-height: 48rpx;
	word-wrap: break-word;
  }
  
  /* 用户消息 */
  .doubao-user {
	justify-content: flex-end;
  }
  .doubao-user-bubble {
	background-color: #d3eafd;
	color: #333;
	margin-left: auto;
  }
  
  /* AI消息 */
  .doubao-ai {
	align-items: flex-start;
  }
  .doubao-avatar {
	width: 64rpx;
	height: 64rpx;
	border-radius: 50%;
	margin-right: 20rpx;
	margin-top: 8rpx;
  }
  .doubao-ai-bubble {
	background-color: #fff;
	border: 1px solid #eee;
	color: #333;
  }
  
  /* 加载中动画 */
  .doubao-loading {
	display: flex;
	align-items: center;
	margin: 32rpx 0;
  }
  .doubao-loading .dot {
	font-size: 40rpx;
	animation: dotScale 1s infinite;
	margin-right: 8rpx;
  }
  @keyframes dotScale {
	0%, 100% { transform: scale(1); }
	50% { transform: scale(1.5); }
  }
  
  /* 底部交互栏 */
  .doubao-footer {
	display: flex;
	align-items: center;
	height: 100rpx;
	padding: 0 24rpx;
	background-color: #fff;
	border-top: 1px solid #eee;
  }
  .doubao-input {
	flex: 1;
	height: 72rpx;
	margin-right: 24rpx;
	padding: 0 24rpx;
	background-color: #f7f8fa;
	border-radius: 36rpx;
	font-size: 32rpx;
	color: #333;
  }
  .doubao-send {
	width: 140rpx;
	height: 72rpx;
	line-height: 72rpx;
	text-align: center;
	background-color: #0081ff;
	color: #fff;
	font-size: 32rpx;
	border-radius: 36rpx;
  }
  .doubao-send[disabled] {
	background-color: #ccc;
  }
.page {
  position: relative;
  min-height: 100vh;
}

.action-panel {
  position: relative;
  margin-top: 8rpx;
}

.action-kicker {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d71bf;
}

.action-title {
}

.action-subtitle {
}

.action-buttons {
  margin-top: 22rpx;
  display: flex;
  justify-content: space-between;
}

.action-btn {
  width: 49% !important;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
}

.action-btn::after {
  border: 0;
}

.action-btn-primary {
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(72, 119, 201, 0.22);
}

.action-btn-secondary {
  background: rgba(255, 255, 255, 0.88);
  color: #2f63b4;
  border: 1rpx solid rgba(100, 150, 220, 0.18);
}

.back {
  position: relative;
  width: 188rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  margin: 18rpx 0 0 auto;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(26, 32, 54, 0.12);
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.back-text {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #2d2f4a;
}

.agent-card {
  margin-top: 18rpx;
  min-height: 64vh;
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(124, 170, 232, 0.14);
  box-shadow: 0 16rpx 34rpx rgba(65, 107, 173, 0.10);
}

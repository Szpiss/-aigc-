page {
  height: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, #f4f9ff 0%, #eef5ff 46%, #f8fbff 100%);
}

.agent-page {
  height: 100vh;
  overflow: hidden;
  color: #142238;
  background: linear-gradient(180deg, #f4f9ff 0%, #eef5ff 46%, #f8fbff 100%);
}

.agent-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.agent-topbar {
  flex-shrink: 0;
  box-sizing: border-box;
}

.agent-topbar__content {
  display: flex;
  align-items: center;
  min-width: 0;
  box-sizing: border-box;
}

.topbar-menu,
.topbar-home,
.drawer-item,
.mode-button,
.simple-card,
.segment,
.mode-option,
.primary-action,
.context-error button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  border: 0;
  line-height: normal;
  text-align: center;
}

.topbar-menu::after,
.topbar-home::after,
.drawer-item::after,
.mode-button::after,
.simple-card::after,
.segment::after,
.mode-option::after,
.primary-action::after,
.context-error button::after {
  border: 0;
}

.topbar-menu {
  flex-shrink: 0;
  width: 68rpx !important;
  min-width: 68rpx;
  height: 100%;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.90);
  color: #28558c;
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx rgba(65, 107, 173, 0.10);
}

.topbar-title {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  overflow: hidden;
  color: #142238;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar-home {
  flex-shrink: 0;
  width: 96rpx !important;
  min-width: 96rpx;
  height: 100%;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6aa8ff 0%, #6676ee 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx rgba(81, 120, 220, 0.20);
}

.drawer-mask {
  position: fixed;
  z-index: 50;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: none;
  background: rgba(20, 34, 56, 0.28);
}

.drawer-mask--show {
  display: block;
}

.agent-drawer {
  position: fixed;
  z-index: 60;
  left: 24rpx;
  width: 500rpx;
  max-width: calc(100vw - 48rpx);
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(118, 139, 166, 0.16);
  box-shadow: 0 24rpx 54rpx rgba(43, 64, 92, 0.20);
  transform: translateX(-112%);
  transition: transform 180ms ease;
}

.agent-drawer--open {
  transform: translateX(0);
}

.drawer-kicker,
.drawer-title,
.drawer-item__label {
  display: block;
}

.drawer-kicker {
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: #3d71bf;
}

.drawer-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #142238;
}

.drawer-list {
  margin-top: 22rpx;
}

.drawer-item {
  justify-content: flex-start;
  width: 100%;
  min-height: 82rpx;
  margin-bottom: 12rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: #f4f8fd;
  color: #52657d;
  text-align: left;
}

.drawer-item--active {
  color: #ffffff;
  background: linear-gradient(135deg, #6aa8ff 0%, #6676ee 100%);
}

.drawer-item__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: rgba(103, 163, 255, 0.14);
  color: #28558c;
  font-size: 20rpx;
  font-weight: 900;
}

.drawer-item--active .drawer-item__icon {
  background: rgba(255, 255, 255, 0.20);
  color: #ffffff;
}

.drawer-item__label {
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
}

.agent-content {
  position: relative;
  flex: 1;
  min-height: 0;
  margin-top: 16rpx;
  overflow: hidden;
}

.context-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #fff7e8;
  color: #91651d;
  font-size: 22rpx;
}

.context-error button {
  min-width: 92rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #91651d;
  font-size: 20rpx;
  font-weight: 800;
}

.chat-page {
  position: relative;
  height: 100%;
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(118, 139, 166, 0.14);
  box-shadow: 0 16rpx 38rpx rgba(43, 64, 92, 0.08);
}

.chat-host {
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

.module-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.module-page {
  width: 100%;
  min-height: 100%;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-head,
.vocab-hero,
.setup-card,
.summary-card,
.analysis-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(118, 139, 166, 0.14);
  box-shadow: 0 14rpx 30rpx rgba(43, 64, 92, 0.07);
}

.page-title,
.page-desc,
.hero-kicker,
.hero-title,
.hero-subtitle,
.mode-title,
.mode-desc,
.simple-card__title,
.simple-card__desc,
.simple-card__button,
.setup-label,
.mode-option__title,
.mode-option__desc,
.analysis-card__title,
.analysis-card__body,
.summary-stat__label,
.summary-stat__value,
.battle-summary__value {
  display: block;
}

.page-title {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #142238;
}

.page-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #607188;
}

.vocab-hero {
  background: linear-gradient(135deg, rgba(255,255,255,0.96) 0%, rgba(238,232,255,0.92) 100%);
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: #3d71bf;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.hero-title {
  color: #142238;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: #607188;
  font-size: 24rpx;
  line-height: 1.48;
}

.mode-list {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  margin-top: 24rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.mode-button {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100% !important;
  min-height: 148rpx;
  margin: 0 0 20rpx;
  padding: 26rpx 26rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 34rpx rgba(65, 107, 173, 0.10);
  text-align: left;
}

.mode-daily {
  background: linear-gradient(135deg, #69a8ff 0%, #6676ee 100%);
}

.mode-test {
  background: rgba(255, 255, 255, 0.96);
}

.mode-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: rgba(103, 163, 255, 0.12);
}

.mode-daily .mode-icon-wrap {
  background: rgba(255, 255, 255, 0.20);
}

.mode-icon {
  color: #3d71bf;
  font-size: 28rpx;
  font-weight: 900;
}

.mode-daily .mode-icon {
  color: #ffffff;
}

.mode-text {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 22rpx;
  text-align: left;
}

.mode-title {
  color: #142238;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
}

.mode-daily .mode-title {
  color: #ffffff;
}

.mode-desc {
  margin-top: 8rpx;
  color: #7a8ca8;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 700;
}

.mode-daily .mode-desc {
  color: rgba(255, 255, 255, 0.84);
}

.mode-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 66rpx;
  min-height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(103, 163, 255, 0.12);
  color: #3d71bf;
  font-size: 22rpx;
  font-weight: 900;
}

.mode-daily .mode-tag {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.20);
}

.setup-card,
.summary-card {
  margin-top: 0;
}

.setup-card .page-head,
.summary-card .page-head {
  padding: 0;
  border: 0;
  box-shadow: none;
  background: transparent;
}

.setup-section {
  margin-top: 28rpx;
}

.setup-label {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #263852;
}

.segmented,
.mode-options,
.summary-grid,
.battle-summary {
  display: flex;
  gap: 14rpx;
}

.segment {
  flex: 1;
  min-height: 68rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  background: #f0f5fa;
  color: #586b82;
  font-size: 23rpx;
  font-weight: 900;
}

.segment--active {
  color: #ffffff;
  background: #28558c;
}

.mode-option {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  min-height: 126rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f6f9fc;
  text-align: left;
}

.mode-option--active {
  background: #e8f0f8;
  box-shadow: inset 0 0 0 2rpx rgba(40, 85, 140, 0.28);
}

.mode-option__title {
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #142238;
}

.mode-option__desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #607188;
}

.primary-action {
  width: 100%;
  min-height: 72rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6aa8ff 0%, #6676ee 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 24rpx rgba(81, 120, 220, 0.20);
}

.setup-error {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #fff1ee;
  color: #b34b38;
  font-size: 22rpx;
}

.embedded-learning {
  min-height: 100%;
  overflow: hidden;
  border-radius: 28rpx;
  background: #f6f9fc;
  border: 1rpx solid rgba(118, 139, 166, 0.14);
}

.summary-grid {
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.summary-stat {
  width: calc(50% - 7rpx);
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f6f9fc;
  border: 1rpx solid rgba(118, 139, 166, 0.12);
}

.summary-stat__label,
.battle-summary__metric text {
  font-size: 21rpx;
  color: #7a899b;
}

.summary-stat__value,
.battle-summary__value {
  margin-top: 8rpx;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #142238;
}

.limit-note {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #eef4f8;
  color: #28558c;
  font-size: 22rpx;
  font-weight: 800;
}

.battle-summary {
  margin-top: 18rpx;
}

.battle-summary__metric {
  flex: 1;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(118, 139, 166, 0.14);
}

.analysis-card {
  margin-top: 18rpx;
}

.analysis-card__title {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 900;
  color: #142238;
}

.analysis-card__body {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #607188;
}

@media (max-width: 900px) {
  .agent-shell {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .mode-options,
  .battle-summary {
    flex-direction: column;
  }

  .summary-stat {
    width: calc(50% - 7rpx);
  }
}
